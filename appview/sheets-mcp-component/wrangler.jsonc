{
  "name": "kotodama-r8fitt3i",
  "main": "src/app.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"oauth-redirect\"]",
    "APP_DESCRIPTION": "Thin edge facade; Google Sheets OAuth and sync run in BPMN + Zeebe Python",
    "APP_DISPLAY_NAME": "Sheets",
    "APP_EMBED_URL": "https://r8fitt3i.itonami.app/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-edge-bff",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.itonami.app/xrpc/app.itonami.mcp.message",
    "APP_NANOID": "r8fitt3i",
    "APP_PERFORMER_TYPE": "system",
    "APP_UI_TYPE": "appview"
  },
  "routes": [
    {
      "pattern": "r8fitt3i.itonami.app/*",
      "zone_name": "itonami.app"
    },
    {
      "pattern": "kazu.itonami.app/*",
      "zone_name": "itonami.app"
    }
  ]
}
