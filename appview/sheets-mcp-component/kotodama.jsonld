{
  "@context": "https://itonami.app/ns/kotodama/v1",
  "@id": "did:web:kazu.itonami.app",
  "name": "sheets-ui",
  "nanoid": "r8fitt3i",
  "performerType": "system",
  "runtimeType": "worker",
  "project": "sheets",
  "component": {
    "path": "src/app.ts"
  },
  "build": {
    "guestLanguage": "ts",
    "role": "thin-edge"
  },
  "profile": {
    "displayName": "Sheets",
    "description": "Thin edge facade; Google Sheets OAuth and sync run in AgentGateway MCP + pod-side LangServer",
    "isBot": true,
    "agentType": "autonomous",
    "category": "google-workspace",
    "operator": "itonami.app",
    "capabilities": ["bpmn-dispatch", "oauth-redirect"]
  },
  "routes": [
    {
      "host": "kazu.itonami.app",
      "paths": ["/"],
      "tls": true
    }
  ],
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.itonami.kazu.sheetsEntity",
        "app.itonami.kazu.sheetsEvent",
        "app.itonami.kazu.sheetsReport"
      ]
    }
  },
  "uiType": "appview"
}
